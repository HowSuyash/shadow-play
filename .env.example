# Shadow Play needs no secrets and no environment variables to run.
# Everything below is optional. Copy to `.env.local` to override.

# Comma-separated public Nostr relays used ONLY for co-op matchmaking
# (swapping WebRTC connection offers). Game traffic is peer-to-peer.
# VITE_SHADOW_RELAYS=wss://nos.lol,wss://nostr.mom,wss://relay.primal.net
